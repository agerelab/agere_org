{
  "opacity": {
    "0": {
      "$type": "number",
      "$value": 0
    },
    "5": {
      "$type": "number",
      "$value": 0.05
    },
    "10": {
      "$type": "number",
      "$value": 0.1
    },
    "20": {
      "$type": "number",
      "$value": 0.2
    },
    "30": {
      "$type": "number",
      "$value": 0.3
    },
    "40": {
      "$type": "number",
      "$value": 0.4
    },
    "50": {
      "$type": "number",
      "$value": 0.5
    },
    "60": {
      "$type": "number",
      "$value": 0.6
    },
    "70": {
      "$type": "number",
      "$value": 0.7
    },
    "80": {
      "$type": "number",
      "$value": 0.8
    },
    "90": {
      "$type": "number",
      "$value": 0.9
    },
    "100": {
      "$type": "number",
      "$value": 1
    },
    "$description": "Opacity scale (0–1).",
    "disabled": {
      "$type": "number",
      "$value": 0.5,
      "$description": "Disabled controls. Exempt from contrast (WCAG 1.4.3 incidental)."
    },
    "scrim": {
      "$type": "number",
      "$value": 0.5,
      "$description": "Modal overlay"
    },
    "hover-overlay": {
      "$type": "number",
      "$value": 0.04
    },
    "pressed-overlay": {
      "$type": "number",
      "$value": 0.08
    }
  },
  "blur": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "overlay": {
      "$type": "dimension",
      "$value": "{blur.sm}",
      "$description": "Behind modal scrim"
    },
    "glass": {
      "$type": "dimension",
      "$value": "{blur.xl}",
      "$description": "Sticky translucent header"
    }
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "0ms"
    },
    "fast": {
      "$type": "duration",
      "$value": "100ms"
    },
    "base": {
      "$type": "duration",
      "$value": "150ms"
    },
    "moderate": {
      "$type": "duration",
      "$value": "200ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "300ms"
    },
    "slower": {
      "$type": "duration",
      "$value": "500ms"
    }
  },
  "ease": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "$description": "Drawers, dialogs (cal.com)"
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        1,
        1
      ]
    }
  },
  "border-width": {
    "default": {
      "$type": "dimension",
      "$value": "1px"
    },
    "thick": {
      "$type": "dimension",
      "$value": "2px"
    },
    "focus": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "z": {
    "base": {
      "$type": "number",
      "$value": 0
    },
    "raised": {
      "$type": "number",
      "$value": 10
    },
    "sticky": {
      "$type": "number",
      "$value": 20
    },
    "header": {
      "$type": "number",
      "$value": 30
    },
    "drawer": {
      "$type": "number",
      "$value": 40
    },
    "overlay": {
      "$type": "number",
      "$value": 50
    },
    "modal": {
      "$type": "number",
      "$value": 50
    },
    "popover": {
      "$type": "number",
      "$value": 60
    },
    "toast": {
      "$type": "number",
      "$value": 70
    },
    "tooltip": {
      "$type": "number",
      "$value": 80
    }
  }
}