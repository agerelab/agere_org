      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.xs}",
        "lineHeight": "{font.line-height.4}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "Helper text, timestamps"
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "{font.size.2xs}",
        "lineHeight": "{font.line-height.4}",
        "letterSpacing": "{font.letter-spacing.caps}"
      },
      "$description": "Uppercase section eyebrow"
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "{font.size.sm}",
        "lineHeight": "{font.line-height.5}",
        "letterSpacing": "{font.letter-spacing.normal}"
      }
